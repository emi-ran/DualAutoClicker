<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <Color x:Key="BgDarkColor">#0F1115</Color>
    <Color x:Key="BgElevatedColor">#14171C</Color>
    <Color x:Key="BgCardColor">#171B21</Color>
    <Color x:Key="BgCardHoverColor">#1D222A</Color>
    <Color x:Key="BgInputColor">#1F242C</Color>
    <Color x:Key="BorderColorValue">#2B323C</Color>
    <Color x:Key="BorderSubtleColor">#222831</Color>

    <!-- Accent: one calm blue for selection and primary actions -->
    <Color x:Key="AccentColorValue">#5B9BFF</Color>
    <Color x:Key="AccentHoverColorValue">#78AEFF</Color>
    <Color x:Key="AccentTextColorValue">#A9C8FF</Color>
    <Color x:Key="AccentTintColorValue">#1B2942</Color>
    <Color x:Key="AccentTintHoverColorValue">#223556</Color>
    <Color x:Key="OnAccentColorValue">#0B1220</Color>

    <!-- Semantic states -->
    <Color x:Key="SuccessColorValue">#4CC38A</Color>
    <Color x:Key="SuccessTintColorValue">#16281F</Color>
    <Color x:Key="WarningColorValue">#D9A441</Color>
    <Color x:Key="WarningTintColorValue">#2A2418</Color>
    <Color x:Key="DangerColorValue">#E06C6C</Color>
    <Color x:Key="DangerTintColorValue">#2C1B1B</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#E9EDF2</Color>
    <Color x:Key="TextSecondaryColor">#A8B2BF</Color>
    <Color x:Key="TextMutedColor">#78828F</Color>

    <!-- Background brushes -->
    <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDarkColor}" />
    <SolidColorBrush x:Key="BgElevatedBrush" Color="{StaticResource BgElevatedColor}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="BgCardHoverBrush" Color="{StaticResource BgCardHoverColor}" />
    <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource BgInputColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColorValue}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />

    <!-- Accent brushes -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColorValue}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColorValue}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColorValue}" />
    <SolidColorBrush x:Key="AccentTintBrush" Color="{StaticResource AccentTintColorValue}" />
    <SolidColorBrush x:Key="AccentTintHoverBrush" Color="{StaticResource AccentTintHoverColorValue}" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColorValue}" />

    <!-- Semantic brushes -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColorValue}" />
    <SolidColorBrush x:Key="SuccessTintBrush" Color="{StaticResource SuccessTintColorValue}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColorValue}" />
    <SolidColorBrush x:Key="WarningTintBrush" Color="{StaticResource WarningTintColorValue}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColorValue}" />
    <SolidColorBrush x:Key="DangerTintBrush" Color="{StaticResource DangerTintColorValue}" />

    <!-- Text brushes -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <!-- Window caption buttons -->
    <SolidColorBrush x:Key="WindowControlHoverBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="WindowControlPressedBrush" Color="#10FFFFFF" />

    <!-- Keep the built-in ToggleSwitch in the same accent family -->
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{StaticResource AccentColorValue}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{StaticResource AccentHoverColorValue}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{StaticResource AccentHoverColorValue}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="{StaticResource BgInputColor}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="{StaticResource BorderColorValue}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="{StaticResource TextMutedColor}" />

    <!-- Dialogs -->
    <SolidColorBrush x:Key="ContentDialogBackground" Color="{StaticResource BgElevatedColor}" />
    <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="{StaticResource BorderColorValue}" />

    <!-- Corner radius -->
    <CornerRadius x:Key="SmallRadius">6</CornerRadius>
    <CornerRadius x:Key="MediumRadius">10</CornerRadius>
    <CornerRadius x:Key="LargeRadius">14</CornerRadius>
    <CornerRadius x:Key="PillRadius">999</CornerRadius>

    <!-- Spacing -->
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="InsetPadding">14</Thickness>
    <Thickness x:Key="PagePadding">24,20,24,28</Thickness>

</ResourceDictionary>
