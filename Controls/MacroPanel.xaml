<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DualAutoClicker.Controls.MacroPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DualAutoClicker.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Background="{StaticResource BgCardBrush}" 
            CornerRadius="{StaticResource MediumRadius}"
            Padding="20"
            BorderThickness="0,3,0,0">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="{StaticResource AccentGreenColor}" Offset="0"/>
                <GradientStop Color="{StaticResource AccentCyanColor}" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE765;" FontSize="20" Foreground="{StaticResource AccentGreenBrush}"/>
                    <CheckBox x:Name="EnabledCheckBox" 
                              Content="KLAVYE MAKRO"
                              FontSize="16"
                              FontWeight="SemiBold"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Checked="EnabledCheckBox_Changed"
                              Unchecked="EnabledCheckBox_Changed"/>
                </StackPanel>
            </Grid>

            <!-- Activation Key Row -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="Aktivasyon Tuşu" 
                           Style="{StaticResource BodyTextStyle}"
                           VerticalAlignment="Center"/>

                <Border Grid.Column="1" Style="{StaticResource KeyLabelStyle}" Margin="0,0,8,0">
                    <TextBlock x:Name="KeyLabel" 
                               Text="Yok" 
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentGreenBrush}"
                               HorizontalAlignment="Center"/>
                </Border>

                <Button x:Name="ChangeKeyButton" 
                        Grid.Column="2"
                        Content="Seç"
                        Padding="12,6"
                        Click="ChangeKeyButton_Click">
                    <Button.Background>
                        <SolidColorBrush Color="{StaticResource AccentGreenColor}"/>
                    </Button.Background>
                </Button>
            </Grid>

            <!-- Base Text Input -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="Metin" 
                           Style="{StaticResource BodyTextStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>

                <TextBox x:Name="BaseTextBox" 
                         Grid.Column="1"
                         PlaceholderText="Gönderilecek metin (örn: 3/4 vc)"
                         Background="{StaticResource BgInputBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         TextChanged="BaseTextBox_TextChanged"/>
            </Grid>

            <!-- Random Chars Config -->
            <Border Grid.Row="3" 
                    Background="{StaticResource BgInputBrush}" 
                    CornerRadius="{StaticResource SmallRadius}"
                    Padding="16,12">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Min Chars -->
                    <Grid Grid.Column="0" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0"
                                   Text="Min" 
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentGreenBrush}"
                                   VerticalAlignment="Center"/>
                                   
                        <NumberBox x:Name="MinCharsBox"
                                   Grid.Column="1"
                                   Value="3"
                                   Minimum="1"
                                   Maximum="50"
                                   SpinButtonPlacementMode="Hidden"
                                   SmallChange="1"
                                   LargeChange="5"
                                   ValueChanged="MinCharsBox_ValueChanged"
                                   Background="{StaticResource BgCardBrush}"
                                   BorderBrush="{StaticResource BorderBrush}"
                                   BorderThickness="1"
                                   CornerRadius="4"/>
                    </Grid>

                    <!-- Max Chars -->
                    <Grid Grid.Column="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0"
                                   Text="Max" 
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentCyanBrush}"
                                   VerticalAlignment="Center"/>
                                   
                        <NumberBox x:Name="MaxCharsBox"
                                   Grid.Column="1"
                                   Value="10"
                                   Minimum="1"
                                   Maximum="50"
                                   SpinButtonPlacementMode="Hidden"
                                   SmallChange="1"
                                   LargeChange="5"
                                   ValueChanged="MaxCharsBox_ValueChanged"
                                   Background="{StaticResource BgCardBrush}"
                                   BorderBrush="{StaticResource BorderBrush}"
                                   BorderThickness="1"
                                   CornerRadius="4"/>
                    </Grid>

                    <!-- Junk Characters -->
                    <Grid Grid.Column="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0"
                                   Text="Karakterler" 
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   ToolTipService.ToolTip="Rastgele eklenecek karakterler"/>
                                   
                        <TextBox x:Name="JunkCharsBox"
                                 Grid.Column="1"
                                 Text=":;*!'.,:&quot;~"
                                 Background="{StaticResource BgCardBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 BorderThickness="1"
                                 CornerRadius="4"
                                 TextChanged="JunkCharsBox_TextChanged"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
