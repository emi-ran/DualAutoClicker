<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DualAutoClicker.Controls.MacroPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DualAutoClicker.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Style="{StaticResource CardPanelStyle}">
        <Grid RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource IconTileStyle}">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="17"
                        Foreground="{StaticResource AccentTextBrush}"
                        Glyph="&#xE765;" />
                </Border>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        Style="{StaticResource CardTitleTextStyle}"
                        Text="Klavye makrosu" />
                    <TextBlock
                        Style="{StaticResource CaptionTextStyle}"
                        Text="Tek tuşla otomatik metin gönderir." />
                </StackPanel>

                <ToggleSwitch
                    x:Name="EnabledCheckBox"
                    Grid.Column="2"
                    Width="52"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Klavye makrosunu etkinleştir"
                    OffContent=""
                    OnContent=""
                    Style="{StaticResource CompactToggleSwitchStyle}"
                    Toggled="EnabledCheckBox_Changed" />
            </Grid>

            <Border
                Grid.Row="1"
                Height="1"
                Background="{StaticResource BorderSubtleBrush}" />

            <!-- Activation key -->
            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        Style="{StaticResource FieldLabelTextStyle}"
                        Text="Etkinleştirme tuşu" />
                    <TextBlock
                        Style="{StaticResource CaptionTextStyle}"
                        Text="Alt, Ctrl ve Shift kombinasyonları desteklenir" />
                    <TextBlock
                        x:Name="CaptureHint"
                        Margin="0,2,0,0"
                        Foreground="{StaticResource AccentTextBrush}"
                        Style="{StaticResource CaptionTextStyle}"
                        Text="Bir tuşa veya fare düğmesine basın · İptal: Esc"
                        Visibility="Collapsed" />
                </StackPanel>

                <Border
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource KeyLabelStyle}">
                    <TextBlock
                        x:Name="KeyLabel"
                        Style="{StaticResource KeyTextStyle}"
                        Text="Yok" />
                </Border>

                <Button
                    x:Name="ChangeKeyButton"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Makro etkinleştirme tuşunu seç"
                    Click="ChangeKeyButton_Click"
                    Content="Seç"
                    Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>

            <!-- Text -->
            <StackPanel Grid.Row="3" Spacing="6">
                <TextBlock
                    Style="{StaticResource FieldLabelTextStyle}"
                    Text="Gönderilecek metin" />
                <TextBox
                    x:Name="BaseTextBox"
                    AutomationProperties.Name="Gönderilecek metin"
                    PlaceholderText="Örn. 3/4 vc"
                    Style="{StaticResource FormTextBoxStyle}"
                    TextChanged="BaseTextBox_TextChanged" />
                <TextBlock
                    Style="{StaticResource CaptionTextStyle}"
                    Text="En fazla 200 karakter gönderilir." />
            </StackPanel>

            <!-- Random appendix -->
            <Border Grid.Row="4" Style="{StaticResource InsetPanelStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="2">
                        <TextBlock
                            Style="{StaticResource FieldLabelTextStyle}"
                            Text="Rastgele ek" />
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="Metnin sonuna rastgele karakterler eklenir." />
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="1.6*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock
                                Style="{StaticResource CaptionTextStyle}"
                                Text="En az" />
                            <NumberBox
                                x:Name="MinCharsBox"
                                AutomationProperties.Name="En az rastgele karakter sayısı"
                                LargeChange="5"
                                Maximum="50"
                                Minimum="1"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Style="{StaticResource FormNumberBoxStyle}"
                                ToolTipService.ToolTip="Eklenecek en az karakter sayısı"
                                Value="3"
                                ValueChanged="MinCharsBox_ValueChanged" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock
                                Style="{StaticResource CaptionTextStyle}"
                                Text="En çok" />
                            <NumberBox
                                x:Name="MaxCharsBox"
                                AutomationProperties.Name="En çok rastgele karakter sayısı"
                                LargeChange="5"
                                Maximum="50"
                                Minimum="1"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Style="{StaticResource FormNumberBoxStyle}"
                                ToolTipService.ToolTip="Eklenecek en çok karakter sayısı"
                                Value="10"
                                ValueChanged="MaxCharsBox_ValueChanged" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="6">
                            <TextBlock
                                Style="{StaticResource CaptionTextStyle}"
                                Text="Karakter havuzu" />
                            <TextBox
                                x:Name="JunkCharsBox"
                                AutomationProperties.Name="Rastgele karakter havuzu"
                                PlaceholderText="Örn. :;*!'.,&quot;~"
                                Style="{StaticResource FormTextBoxStyle}"
                                Text=":;*!'.,:&quot;~"
                                TextChanged="JunkCharsBox_TextChanged"
                                ToolTipService.ToolTip="Rastgele seçilecek karakterler" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
