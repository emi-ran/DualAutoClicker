<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DualAutoClicker.Controls.ClickerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DualAutoClicker.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        x:Name="CardRoot"
        IsTabStop="True"
        AutomationProperties.Name="Tıklama kartı"
        GotFocus="CardRoot_GotFocus"
        LostFocus="CardRoot_LostFocus"
        PointerPressed="CardRoot_PointerPressed"
        Style="{StaticResource CardPanelStyle}">
        <Grid RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Width="40"
                    Height="40"
                    VerticalAlignment="Center"
                    Background="{StaticResource AccentTintBrush}"
                    CornerRadius="{StaticResource SmallRadius}">
                    <TextBlock
                        x:Name="HeaderBadgeText"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource AccentTextBrush}"
                        Text="SOL" />
                </Border>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="3">
                    <TextBlock
                        x:Name="TitleText"
                        Style="{StaticResource CardTitleTextStyle}"
                        Text="Sol tık" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse
                            x:Name="StatusIndicator"
                            Width="6"
                            Height="6"
                            VerticalAlignment="Center"
                            Fill="{StaticResource TextMutedBrush}" />
                        <TextBlock
                            x:Name="StatusText"
                            VerticalAlignment="Center"
                            AutomationProperties.LiveSetting="Polite"
                            FontSize="11.5"
                            Foreground="{StaticResource TextMutedBrush}"
                            Text="Hazır" />
                    </StackPanel>
                </StackPanel>

                <ToggleSwitch
                    x:Name="EnabledCheckBox"
                    Grid.Column="2"
                    Width="52"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Sol tık etkinleştir"
                    OffContent=""
                    OnContent=""
                    Style="{StaticResource CompactToggleSwitchStyle}"
                    Toggled="EnabledCheckBox_Changed" />
            </Grid>

            <Border
                Grid.Row="1"
                Height="1"
                Background="{StaticResource BorderSubtleBrush}" />

            <!-- Activation key -->
            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        Style="{StaticResource FieldLabelTextStyle}"
                        Text="Etkinleştirme tuşu" />
                    <TextBlock
                        Style="{StaticResource CaptionTextStyle}"
                        Text="Fare düğmesi veya klavye tuşu" />
                    <TextBlock
                        x:Name="CaptureHint"
                        Margin="0,2,0,0"
                        Foreground="{StaticResource AccentTextBrush}"
                        Style="{StaticResource CaptionTextStyle}"
                        Text="Bir tuşa veya fare düğmesine basın · İptal: Esc"
                        Visibility="Collapsed" />
                </StackPanel>

                <Border
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource KeyLabelStyle}">
                    <TextBlock
                        x:Name="KeyLabel"
                        Style="{StaticResource KeyTextStyle}"
                        Text="MB5" />
                </Border>

                <Button
                    x:Name="ChangeKeyButton"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Etkinleştirme tuşunu değiştir"
                    Click="ChangeKeyButton_Click"
                    Content="Değiştir"
                    Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>

            <!-- Activation mode -->
            <Grid Grid.Row="3" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        Style="{StaticResource FieldLabelTextStyle}"
                        Text="Çalışma modu" />
                    <TextBlock
                        Style="{StaticResource CaptionTextStyle}"
                        Text="Basılı tut veya aç/kapat" />
                </StackPanel>

                <Border
                    Grid.Column="1"
                    Padding="3"
                    VerticalAlignment="Center"
                    Background="{StaticResource BgInputBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource SmallRadius}">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <RadioButton
                            x:Name="HoldRadio"
                            AutomationProperties.Name="Basılı tut modu"
                            Checked="ModeRadio_Changed"
                            Content="Basılı tut"
                            Style="{StaticResource SegmentedRadioButtonStyle}" />
                        <RadioButton
                            x:Name="ToggleRadio"
                            AutomationProperties.Name="Aç kapat modu"
                            Checked="ModeRadio_Changed"
                            Content="Aç/kapat"
                            Style="{StaticResource SegmentedRadioButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Speed -->
            <Border Grid.Row="4" Style="{StaticResource InsetPanelStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                                Style="{StaticResource FieldLabelTextStyle}"
                                Text="Tıklama hızı" />
                            <TextBlock
                                Style="{StaticResource CaptionTextStyle}"
                                Text="Saniyedeki tıklama sayısı (1-100)" />
                        </StackPanel>
                        <NumberBox
                            x:Name="CpsNumberBox"
                            Grid.Column="1"
                            Width="104"
                            VerticalAlignment="Center"
                            LargeChange="5"
                            Maximum="100"
                            Minimum="1"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            Style="{StaticResource FormNumberBoxStyle}"
                            Value="20"
                            ValueChanged="CpsNumberBox_ValueChanged" />
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                                Style="{StaticResource FieldLabelTextStyle}"
                                Text="Rastgelelik" />
                            <TextBlock
                                Style="{StaticResource CaptionTextStyle}"
                                Text="Aralığa %0-30 varyasyon ekler" />
                        </StackPanel>
                        <NumberBox
                            x:Name="RandomNumberBox"
                            Grid.Column="1"
                            Width="104"
                            VerticalAlignment="Center"
                            LargeChange="5"
                            Maximum="30"
                            Minimum="0"
                            SmallChange="1"
                            SpinButtonPlacementMode="Compact"
                            Style="{StaticResource FormNumberBoxStyle}"
                            Value="0"
                            ValueChanged="RandomNumberBox_ValueChanged" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
