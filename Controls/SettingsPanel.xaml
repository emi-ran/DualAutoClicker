<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DualAutoClicker.Controls.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DualAutoClicker.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Background="{StaticResource BgCardBrush}" 
            CornerRadius="{StaticResource MediumRadius}"
            Padding="20"
            BorderThickness="0,3,0,0">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="{StaticResource AccentOrangeColor}" Offset="0"/>
                <GradientStop Color="{StaticResource AccentPinkColor}" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE713;" FontSize="20" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="AYARLAR" Style="{StaticResource TitleTextStyle}"/>
            </StackPanel>

            <!-- Settings Row -->
            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Master Control Section -->
                <Border Grid.Column="0" 
                        Background="{StaticResource BgInputBrush}" 
                        CornerRadius="{StaticResource SmallRadius}"
                        Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0" Glyph="&#xE72E;" FontSize="18" 
                                  Foreground="{StaticResource AccentOrangeBrush}"
                                  Margin="0,0,12,0" VerticalAlignment="Center"/>

                        <CheckBox x:Name="MasterToggleCheckBox" 
                                  Grid.Column="1"
                                  Content="Master Kontrol"
                                  Foreground="{StaticResource TextPrimaryBrush}"
                                  FontWeight="SemiBold"
                                  ToolTipService.ToolTip="Tüm makroları tek tuşla kontrol edin"
                                  Checked="MasterToggleCheckBox_Changed"
                                  Unchecked="MasterToggleCheckBox_Changed"
                                  VerticalAlignment="Center"/>

                        <Border Grid.Column="2" Style="{StaticResource KeyLabelStyle}" Margin="8,0">
                            <TextBlock x:Name="MasterKeyLabel" 
                                       Text="F8" 
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentOrangeBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>

                        <Button x:Name="MasterKeyButton" 
                                Grid.Column="3"
                                Content="Seç"
                                Padding="12,6"
                                Click="MasterKeyButton_Click">
                            <Button.Background>
                                <SolidColorBrush Color="{StaticResource AccentOrangeColor}"/>
                            </Button.Background>
                        </Button>
                    </Grid>
                </Border>

                <!-- Window Targeting Section -->
                <Border Grid.Column="1" 
                        Background="{StaticResource BgInputBrush}" 
                        CornerRadius="{StaticResource SmallRadius}"
                        Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0" Glyph="&#xE7B3;" FontSize="18" 
                                  Foreground="{StaticResource AccentCyanBrush}"
                                  Margin="0,0,12,0" VerticalAlignment="Center"/>

                        <Button x:Name="WindowPickerButton" 
                                Grid.Column="1"
                                Content="Uygulama Seç"
                                Margin="0,0,12,0"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="WindowPickerButton_Click"/>

                        <TextBlock x:Name="WindowStatusLabel" 
                                   Grid.Column="2"
                                   Text="Tüm Uygulamalar"
                                   Style="{StaticResource BodyTextStyle}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom Row -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Startup Checkbox -->
                <CheckBox x:Name="StartupCheckBox" 
                          Grid.Column="0"
                          Content="Windows ile başlat"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          Checked="StartupCheckBox_Changed"
                          Unchecked="StartupCheckBox_Changed"/>


            </Grid>
        </Grid>
    </Border>
</UserControl>
