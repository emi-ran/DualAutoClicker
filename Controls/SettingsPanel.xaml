<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DualAutoClicker.Controls.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DualAutoClicker.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Style="{StaticResource CardPanelStyle}">
        <Grid RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource IconTileStyle}">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="17"
                        Foreground="{StaticResource AccentTextBrush}"
                        Glyph="&#xE713;" />
                </Border>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        Style="{StaticResource CardTitleTextStyle}"
                        Text="Ayarlar" />
                    <TextBlock
                        Style="{StaticResource CaptionTextStyle}"
                        Text="Sistem entegrasyonu ve genel davranış" />
                </StackPanel>
            </Grid>

            <Border
                Grid.Row="1"
                Height="1"
                Background="{StaticResource BorderSubtleBrush}" />

            <!-- Master control -->
            <Grid Grid.Row="2" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    VerticalAlignment="Top"
                    Background="{StaticResource BgInputBrush}"
                    CornerRadius="{StaticResource SmallRadius}"
                    Style="{StaticResource IconTileStyle}">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Glyph="&#xE72E;" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SettingTitleTextStyle}"
                            Text="Master kontrol" />
                        <StackPanel
                            Margin="2,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <Ellipse
                                x:Name="MasterStateDot"
                                Width="6"
                                Height="6"
                                VerticalAlignment="Center"
                                Fill="{StaticResource SuccessBrush}" />
                            <TextBlock
                                x:Name="MasterStateText"
                                VerticalAlignment="Center"
                                AutomationProperties.LiveSetting="Polite"
                                FontSize="11.5"
                                Foreground="{StaticResource SuccessBrush}"
                                Text="Etkin" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock
                        Style="{StaticResource CaptionTextStyle}"
                        Text="Tüm otomasyonu tek tuşla duraklatın." />

                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="Tuş" />
                        <Border
                            VerticalAlignment="Center"
                            Style="{StaticResource KeyLabelStyle}">
                            <TextBlock
                                x:Name="MasterKeyLabel"
                                Style="{StaticResource KeyTextStyle}"
                                Text="F8" />
                        </Border>
                        <Button
                            x:Name="MasterKeyButton"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Master kontrol tuşunu değiştir"
                            Click="MasterKeyButton_Click"
                            Content="Değiştir"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    </StackPanel>

                    <TextBlock
                        x:Name="CaptureHint"
                        Margin="0,6,0,0"
                        Foreground="{StaticResource AccentTextBrush}"
                        Style="{StaticResource CaptionTextStyle}"
                        Text="Bir tuşa veya fare düğmesine basın · İptal: Esc"
                        Visibility="Collapsed" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource CaptionTextStyle}"
                        Text="Kısayol" />
                    <ToggleSwitch
                        x:Name="MasterToggleCheckBox"
                        Width="52"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="Master kontrol kısayolunu etkinleştir"
                        OffContent=""
                        OnContent=""
                        Style="{StaticResource CompactToggleSwitchStyle}"
                        Toggled="MasterToggleCheckBox_Changed" />
                </StackPanel>

            </Grid>

            <Border
                Grid.Row="3"
                Height="1"
                Background="{StaticResource BorderSubtleBrush}" />

            <!-- Window targeting -->
            <Grid Grid.Row="4" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    VerticalAlignment="Top"
                    Background="{StaticResource BgInputBrush}"
                    CornerRadius="{StaticResource SmallRadius}"
                    Style="{StaticResource IconTileStyle}">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Glyph="&#xE7B3;" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock
                        Style="{StaticResource SettingTitleTextStyle}"
                        Text="Hedef uygulama" />
                    <TextBlock
                        Style="{StaticResource CaptionTextStyle}"
                        Text="Otomasyon yalnızca seçili uygulamalarda çalışır." />
                    <TextBlock
                        x:Name="WindowStatusLabel"
                        Margin="0,4,0,0"
                        Foreground="{StaticResource AccentTextBrush}"
                        Style="{StaticResource BodyTextStyle}"
                        Text="Tüm uygulamalar"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button
                    x:Name="WindowPickerButton"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Hedef uygulamaları seç"
                    Click="WindowPickerButton_Click"
                    Content="Uygulama seç"
                    Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>

            <Border
                Grid.Row="5"
                Height="1"
                Background="{StaticResource BorderSubtleBrush}" />

            <!-- Startup -->
            <Grid Grid.Row="6" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    VerticalAlignment="Top"
                    Background="{StaticResource BgInputBrush}"
                    CornerRadius="{StaticResource SmallRadius}"
                    Style="{StaticResource IconTileStyle}">
                    <FontIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Glyph="&#xE7E8;" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock
                        Style="{StaticResource SettingTitleTextStyle}"
                        Text="Windows ile başlat" />
                    <TextBlock
                        Style="{StaticResource CaptionTextStyle}"
                        Text="Oturum açılışında arka planda başlar." />
                </StackPanel>

                <ToggleSwitch
                    x:Name="StartupCheckBox"
                    Grid.Column="2"
                    Width="52"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Windows ile başlat"
                    OffContent=""
                    OnContent=""
                    Style="{StaticResource CompactToggleSwitchStyle}"
                    Toggled="StartupCheckBox_Changed" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
