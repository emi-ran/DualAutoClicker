<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DualAutoClicker</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Application info -->
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AssemblyName>DualAutoClicker</AssemblyName>
    <Version>3.0.0</Version>
    <Company>DualAutoClicker</Company>
    <Product>Dual AutoClicker</Product>
    <Description>High-performance dual autoclicker with independent left/right click settings - WinUI 3</Description>

    <!-- Publish settings -->
    <DebugType>none</DebugType>
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Windows App SDK -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Exclude old-winforms folder from compilation -->
  <ItemGroup>
    <Compile Remove="old-winforms\**\*.*" />
    <Content Remove="old-winforms\**\*.*" />
    <None Remove="old-winforms\**\*.*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup Condition="'$(WindowsPackageType)' == 'None'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <PropertyGroup Condition="'$(WindowsPackageType)' == 'None'">
    <HasPackageAndPublishMenuAddedByProject>true</HasPackageAndPublishMenuAddedByProject>
  </PropertyGroup>
</Project>
