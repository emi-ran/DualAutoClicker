<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DualAutoClicker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DualAutoClicker"
    xmlns:controls="using:DualAutoClicker.Controls"
    Title="Dual AutoClicker">

    <Grid x:Name="RootGrid" Background="{StaticResource BgDarkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Logo and Profile Buttons -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="16,0,0,0" VerticalAlignment="Center">
                <!-- Logo -->
                <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="20" 
                           Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center"/>

                <!-- Profile Buttons -->
                <ItemsControl x:Name="ProfileButtons" Margin="12,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <!-- Gradient Line at Bottom -->
            <Border Grid.ColumnSpan="3" VerticalAlignment="Bottom" Height="2">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{StaticResource AccentCyanColor}" Offset="0"/>
                        <GradientStop Color="{StaticResource AccentPurpleColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Window Controls -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="MinimizeButton" Style="{StaticResource WindowControlButtonStyle}"
                        Content="&#xE921;" Click="MinimizeButton_Click" ToolTipService.ToolTip="Küçült"/>
                <Button x:Name="MaximizeButton" Style="{StaticResource WindowControlButtonStyle}"
                        Content="&#xE922;" Click="MaximizeButton_Click" ToolTipService.ToolTip="Büyüt"/>
                <Button x:Name="CloseButton" Style="{StaticResource CloseButtonStyle}"
                        Content="&#xE8BB;" Foreground="White" Click="CloseButton_Click" ToolTipService.ToolTip="Kapat"/>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="MainContent" Padding="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Clicker Panels Row -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                <!-- Left Click Panel -->
                <controls:ClickerPanel x:Name="LeftClickPanel" 
                                       Grid.Column="0"
                                       Title="SOL TIK"
                                       AccentColor="{StaticResource AccentCyanColor}"
                                       SecondaryColor="{StaticResource AccentPurpleColor}"
                                       IsLeftClick="True"
                                       VerticalAlignment="Stretch"/>

                <!-- Right Click Panel -->
                <controls:ClickerPanel x:Name="RightClickPanel" 
                                       Grid.Column="2"
                                       Title="SAĞ TIK"
                                       AccentColor="{StaticResource AccentPinkColor}"
                                       SecondaryColor="{StaticResource AccentOrangeColor}"
                                       IsLeftClick="False"
                                       VerticalAlignment="Stretch"/>
            </Grid>

            <!-- Macro Panel -->
            <controls:MacroPanel x:Name="MacroPanel" Grid.Row="1" Margin="0,0,0,16"/>

            <!-- Settings Panel -->
            <controls:SettingsPanel x:Name="SettingsPanel" Grid.Row="2"/>
        </Grid>
        </ScrollViewer>
    </Grid>
</Window>
