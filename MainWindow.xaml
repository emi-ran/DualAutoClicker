<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DualAutoClicker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DualAutoClicker"
    xmlns:controls="using:DualAutoClicker.Controls"
    Title="Dual AutoClicker">

    <Grid x:Name="RootGrid" Background="{StaticResource BgDarkBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{StaticResource BgElevatedBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftCaptionInsetColumn" Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightCaptionInsetColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border x:Name="LeftCaptionInset" Grid.Column="0" />

            <!-- Brand -->
            <StackPanel
                Grid.Column="1"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <Border
                    Width="26"
                    Height="26"
                    Background="{StaticResource AccentTintBrush}"
                    CornerRadius="7">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="10.5"
                        FontWeight="Bold"
                        Foreground="{StaticResource AccentTextBrush}"
                        Text="DA" />
                </Border>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="Dual AutoClicker" />
            </StackPanel>

            <!-- Master state -->
            <Border
                x:Name="MasterStatusPill"
                Grid.Column="2"
                Margin="0,0,14,0"
                Padding="9,4"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource PillRadius}"
                IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse
                        x:Name="MasterStatusDot"
                        Width="6"
                        Height="6"
                        VerticalAlignment="Center"
                        Fill="{StaticResource SuccessBrush}" />
                    <TextBlock
                        x:Name="MasterStatusText"
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        FontSize="11.5"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="Etkin" />
                </StackPanel>
            </Border>

            <!-- Reserve the system caption-button area; Windows draws this single control set. -->
            <Border x:Name="RightCaptionInset" Grid.Column="3" />

            <Border
                Grid.ColumnSpan="4"
                Height="1"
                VerticalAlignment="Bottom"
                Background="{StaticResource BorderSubtleBrush}" />
        </Grid>

        <!-- Profile navigation -->
        <Border
            Grid.Row="1"
            Padding="24,9"
            Background="{StaticResource BgDarkBrush}"
            BorderBrush="{StaticResource BorderSubtleBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource SectionLabelTextStyle}"
                    Text="PROFİLLER" />

                <ScrollViewer
                    Grid.Column="1"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <ItemsControl
                        x:Name="ProfileButtons"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Profil seçimi">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock
                    x:Name="ProfileHint"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextStyle}"
                    Text="Sağ tık: yeniden adlandır" />
            </Grid>
        </Border>

        <!-- Page content -->
        <ScrollViewer
            Grid.Row="2"
            HorizontalContentAlignment="Center"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
                x:Name="MainContent"
                Width="{Binding ActualWidth, ElementName=RootGrid}"
                MaxWidth="1120"
                Padding="{StaticResource PagePadding}"
                HorizontalAlignment="Center"
                RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="2">
                    <TextBlock
                        Style="{StaticResource PageTitleTextStyle}"
                        Text="Kontrol paneli" />
                    <TextBlock
                        Style="{StaticResource CaptionTextStyle}"
                        Text="Sol ve sağ tık ile klavye makrosunu profillere göre yönetin." />
                </StackPanel>

                <!-- Shown when the master switch pauses all automation -->
                <Border
                    x:Name="MasterBanner"
                    Grid.Row="1"
                    Padding="14,12"
                    Background="{StaticResource WarningTintBrush}"
                    BorderBrush="{StaticResource WarningBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource MediumRadius}"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon
                            VerticalAlignment="Top"
                            FontSize="16"
                            Foreground="{StaticResource WarningBrush}"
                            Glyph="&#xE7BA;" />
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="Otomasyon duraklatıldı" />
                            <TextBlock
                                Style="{StaticResource CaptionTextStyle}"
                                Text="Yeniden başlatmak için master kontrol tuşuna basın." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid x:Name="ContentRoot" Grid.Row="2" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid
                        x:Name="ClickersGrid"
                        Grid.Row="0"
                        ColumnSpacing="16"
                        RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <controls:ClickerPanel
                            x:Name="LeftClickPanel"
                            Grid.Row="0"
                            Grid.Column="0"
                            Title="Sol tık"
                            IsLeftClick="True" />

                        <controls:ClickerPanel
                            x:Name="RightClickPanel"
                            Grid.Row="0"
                            Grid.Column="1"
                            Title="Sağ tık"
                            IsLeftClick="False" />
                    </Grid>

                    <controls:MacroPanel x:Name="MacroPanel" Grid.Row="1" />

                    <controls:SettingsPanel x:Name="SettingsPanel" Grid.Row="2" />

                    <TextBlock
                        Grid.Row="3"
                        Margin="0,2,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource CaptionTextStyle}"
                        Text="Değişiklikler otomatik olarak kaydedilir." />
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
